# Copy to .env.production before `vite build`. Nothing in here is a secret:
# since D3 the bundle carries NO token — the terminal signs in with Firebase
# and every request carries the user's ID token. (vite.config REFUSES a build
# that sets VITE_SPREAD_API_TOKEN or VITE_INGEST_TOKEN.)
VITE_API_BASE=https://<backend host>
# The Firebase WEB config — public by design (Firebase console › Project
# settings › Your apps › Web app). It identifies the project; it unlocks nothing
# without a signed-in user the backend's SPREAD_ALLOWED_UIDS lists.
VITE_FIREBASE_API_KEY=<apiKey>
VITE_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=jk-traders-5c752
